# Neon: pooled connection for Vercel Functions (hostname contains -pooler).
# Keep this server-only. Never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Direct connection for migrations; optional if DATABASE_URL is already set.
DATABASE_URL_UNPOOLED=
# Exact public origin without a trailing slash; set your domain on Vercel.
APP_ORIGIN=http://localhost:3000
# Generate with: node scripts/admin-password.mjs
ADMIN_PASSWORD_HASH=
# Optional: override the site's existing Airbnb iCal feed.
AIRBNB_ICAL_URL=
